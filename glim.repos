repositories:
  # Core repositories
  src/glim:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/glim.git
    version: 1.1.0

  # Internal tool repositories
  src/glim_ros2:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/glim_ros2.git
    version: 1.0.0

  # External repositories
  src/glim_ext:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/glim_ext.git
    version: 1.4.0

  src/convert_gnss:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/convert_gnss.git
    version: 1.0.1

  # Libraries (cloned next to glim_ws, built and installed by milla_glim_installer.bash)
  ../gtsam:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/gtsam.git
    version: 1.0.0

  ../iridescence:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/iridescence.git
    version: 1.0.0

  ../gtsam_points:
    type: git
    url: https://gitlab.infra.isfm.vpn:4000/milla/mapping/gtsam_points.git
    version: 1.0.0
